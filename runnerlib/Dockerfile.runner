# Minimal base image for Reactorcide job execution
# This image contains runnerlib and is spawned by the worker for each job
FROM python:3.14-slim-trixie

ARG TARGETARCH
ARG GO_VERSION=1.26.4

# webi installs each package to ~/.local/opt/<name>/bin and writes the same
# paths into ~/.config/envman/PATH.env. Both of the runner's directories are on
# PATH here so an interactive-shell-free CI job finds `webi` itself, and finds
# anything webi installed, without having to source that file.
ENV GOPATH=/go \
    GOROOT=/usr/local/go \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/go/bin:/go/bin:/usr/local/cargo/bin:/home/runner/.local/bin:/home/runner/.local/opt/node/bin:$PATH

# Install system dependencies
# - Common tools needed for most CI/CD jobs
# - sudo for jobs that need to install additional packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        ca-certificates \
        openssh-client \
        rsync \
        curl \
        sudo \
        build-essential \
        pkg-config \
        podman \
        fuse-overlayfs \
        uidmap && \
    rm -rf /var/lib/apt/lists/*

# Install the current stable Go toolchain from official release tarballs.
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
        amd64) go_arch=amd64; go_sha256=1153d3d50e0ac764b447adfe05c2bcf08e889d42a02e0fe0259bd47f6733ad7f ;; \
        arm64) go_arch=arm64; go_sha256=ef758ae7c6cf9267c9c0ef080b8965f453d89ab2d25d9eb22de4405925238768 ;; \
        *) echo "unsupported TARGETARCH for Go: ${TARGETARCH:-amd64}" >&2; exit 1 ;; \
    esac; \
    curl -fsSLo /tmp/go.tgz "https://go.dev/dl/go${GO_VERSION}.linux-${go_arch}.tar.gz"; \
    echo "${go_sha256}  /tmp/go.tgz" | sha256sum -c -; \
    rm -rf /usr/local/go; \
    tar -C /usr/local -xzf /tmp/go.tgz; \
    rm /tmp/go.tgz; \
    mkdir -p "${GOPATH}/bin"; \
    go version

# Install the current stable Rust toolchain with rustup.
RUN set -eux; \
    curl --proto '=https' --tlsv1.2 -fsSLo /tmp/rustup-init https://sh.rustup.rs; \
    sh /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain stable; \
    rm /tmp/rustup-init; \
    chmod -R a+w "${RUSTUP_HOME}" "${CARGO_HOME}"; \
    rustc --version; \
    cargo --version

# Podman default storage driver for this image: vfs. Overlay/fuse-overlayfs
# needs /dev/fuse access we can't rely on in an unprivileged container,
# and podman does not auto-fall-back — it errors out if the configured
# driver can't initialize. vfs works anywhere but trades off speed and
# disk usage (no CoW between layers); fine for bounded CI jobs that spin
# up a stack and tear it down. Users with a more capable runtime can
# override this with ~/.config/containers/storage.conf.
RUN mkdir -p /etc/containers && \
    printf '[storage]\ndriver = "vfs"\n' > /etc/containers/storage.conf

# Create non-root user with home directory
# UID 1001 matches what the worker uses when running containers
RUN useradd -m -u 1001 -s /bin/sh runner && \
    echo "runner ALL=(ALL) NOPASSWD: /usr/bin/apt-get, /usr/bin/apt" >> /etc/sudoers.d/runner

# Install webi (https://webinstall.dev) so a job can pull a portable toolchain
# at a PINNED version without baking every language into this image.
#
#     webi node@22.23.2      # a job needing Node
#     webi node@lts          # or a moving target, if that is what you want
#
# The webi SCRIPT goes to /usr/local/bin, mode 755, so ANY uid can run it. What
# it installs still goes to "$HOME/.local", because webi hardcodes
# WEBI_HOME="${HOME}/.local" (see https://webi.sh/webi) and is per-user by
# design. Those are different concerns and they need different homes:
#
#   - Worker jobs run as uid 1001 with HOME=/home/runner.
#   - `run-local` runs as the HOST uid and bind-mounts an empty, host-uid-owned
#     scratch directory OVER /home/runner (cmd/run_local.go), so anything this
#     image put under /home/runner is hidden at runtime, not merely unreadable.
#
# Installing webi into /home/runner therefore works on a worker and vanishes
# under run-local. A system path works for both, and since run-local keeps
# HOME=/home/runner, the PATH entries at the top of this file stay correct in
# both modes -- they just point at a directory webi populates at job time.
RUN set -eux; \
    curl -sS https://webi.sh/webi | sh; \
    install -m 0755 /root/.local/bin/webi /usr/local/bin/webi; \
    rm -rf /root/.local /root/.config/envman; \
    test -x /usr/local/bin/webi

# Install uv for fast Python package installation
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Set working directory for jobs
WORKDIR /job

# Copy and install runnerlib
COPY . /tmp/runnerlib
RUN cd /tmp/runnerlib && \
    uv pip install --system . && \
    rm -rf /tmp/runnerlib

# Verify installation works
RUN runnerlib --help

# Set ownership of job directory for non-root user
RUN chown runner:runner /job

# Default entrypoint - can be overridden by worker when spawning containers
ENTRYPOINT ["runnerlib"]
CMD ["--help"]
