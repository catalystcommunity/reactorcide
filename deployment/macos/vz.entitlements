<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Required to use Apple's Virtualization.framework (the macOS "vm" JobRunner
	  backend, VM_RUNNERS_PLAN.md VM-3). Without this entitlement on the signed
	  binary, VZVirtualMachine creation fails at runtime. Ad-hoc signing with
	  `codesign -s -` (see scripts/build-macos-worker.sh) is sufficient for
	  local/dev use on Apple Silicon; distribution builds would use a real
	  signing identity plus provisioning.
	-->
	<key>com.apple.security.virtualization</key>
	<true/>
</dict>
</plist>
