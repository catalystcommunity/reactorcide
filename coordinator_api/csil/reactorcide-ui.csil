;; Reactorcide UI/Auth CSIL-RPC service definitions.
;;
;; Two services back the webapp <-> coordinator CSIL-RPC channel described in
;; ("CSIL-RPC UI service"):
;;   - ReactorcideAuth: login/session lifecycle (LinkKeys local-rp/rp modes,
;;     bootstrap admin).
;;   - ReactorcideUi: everything else the management UI needs (capabilities,
;;     orgs/projects, groups/roles, webhook + VCS credential rotation,
;;     write-only secrets + grants, job/workflow cancel/kill, global settings,
;;     trusted identities/domains).
;;
;; Every operation returns a shared ServiceError arm; the go generator special-
;; cases a type literally named "ServiceError" as the error arm when computing
;; a client method's success type, so every op below is `Type -> Response /
;; ServiceError` with no other arms. Timestamps are RFC3339 text (tstr/`text`),
;; not the CBOR tag-0 `timestamp` builtin, per the plan's field design.
;;
;; Regenerate with scripts/generate-csil-ui.sh after editing this file.
options {
    package: "reactorcide-ui",
    version: "v1",
    package_name: "csilapi"
}

;;; Shared error arm for every operation in both services.
ServiceError = {
    code: text,
    message: text
}

;; ---------------------------------------------------------------------------
;; ReactorcideAuth: login/session lifecycle
;; ---------------------------------------------------------------------------

;;; One role/permission grant effective for the authenticated caller.
RoleSummary = {
    scope_type: text, ;; global | org | project
    ? scope_id: text,
    role: text ;; admin | owner | member
}

;;; Identity + effective roles for a logged-in caller.
AuthenticatedIdentity = {
    user_id: text,
    subject: text, ;; LinkKeys subject, e.g. uuid@domain
    handle: text,
    domain: text,
    display_name: text,
    is_global_admin: bool,
    roles: [* RoleSummary]
}

GetAuthConfigRequest = {}
GetAuthConfigResponse = {
    auth_mode: text, ;; none | local-rp | rp
    bootstrap_admin_available: bool,
    has_global_admin: bool
}

BeginLoginRequest = {
    ? identity_hint: text
}
BeginLoginResponse = {
    redirect_url: text,
    attempt_token: text
}

CompleteLoginRequest = {
    attempt_token: text,
    encrypted_token: text
}
CompleteLoginResponse = {
    session_token: text,
    expires_at: text,
    identity: AuthenticatedIdentity
}

AuthenticateRequest = {}
AuthenticateResponse = {
    authenticated: bool,
    ? identity: AuthenticatedIdentity
}

LogoutRequest = {}
LogoutResponse = {
    ok: bool
}

BootstrapAdminRequest = {
    bootstrap_token: text
}
BootstrapAdminResponse = {
    session_token: text,
    expires_at: text
}

service ReactorcideAuth {
    get-auth-config: GetAuthConfigRequest -> GetAuthConfigResponse / ServiceError,
    begin-login: BeginLoginRequest -> BeginLoginResponse / ServiceError,
    complete-login: CompleteLoginRequest -> CompleteLoginResponse / ServiceError,
    authenticate: AuthenticateRequest -> AuthenticateResponse / ServiceError,
    logout: LogoutRequest -> LogoutResponse / ServiceError,
    bootstrap-admin: BootstrapAdminRequest -> BootstrapAdminResponse / ServiceError
}

;; ---------------------------------------------------------------------------
;; ReactorcideUi: management surface
;; ---------------------------------------------------------------------------

;;; Capability booleans, computed by the coordinator against the permission
;;; matrix for the caller + (optional) org/project scope. The webapp renders
;;; conditionally on these; the coordinator remains the sole authorizer.
GetCapabilitiesRequest = {
    ? org_id: text,
    ? project_id: text
}
GetCapabilitiesResponse = {
    view_private: bool,
    cancel_job: bool,
    kill_job: bool,
    retry_job: bool,
    create_project: bool,
    delete_project: bool,
    manage_webhook_secrets: bool,
    manage_vcs_credentials: bool,
    manage_secrets: bool,
    manage_groups: bool,
    manage_workers: bool,
    manage_project_settings: bool,
    manage_trusted_identities: bool,
    manage_global_settings: bool,
    is_global_admin: bool,
    is_org_admin: bool,
    is_project_owner: bool
}

;;; Organizations own all tenant-scoped Reactorcide resources.
OrgSummary = {
    org_id: text,
    name: text,
    display_name: text,
    status: text,
    is_default: bool,
    is_private: bool
}
ListOrgsRequest = {}
ListOrgsResponse = {
    orgs: [* OrgSummary]
}

CreateOrgRequest = {
    name: text,
    ? display_name: text,
    ? is_private: bool
}
CreateOrgResponse = {
    org: OrgSummary
}
UpdateOrgRequest = {
    name: text,
    ? display_name: text,
    ? is_private: bool,
    ? status: text
}
UpdateOrgResponse = {
    org: OrgSummary
}
SetDefaultOrgRequest = {
    name: text
}
SetDefaultOrgResponse = {
    org: OrgSummary
}
DeleteOrgRequest = {
    name: text,
    replacement: text,
    confirm: bool
}
DeleteOrgResponse = {
    replacement: OrgSummary
}

ExecutionProfileSummary = {
    name: text,
    deny_secrets: bool,
    secret_path_allowlist: [* text],
    runtime_capabilities: [* text],
    may_run_as_root: bool,
    allowed_worker_classes: [* text],
    ? timeout_ceiling_seconds: int,
    resource_ceilings: any,
    ? cache_namespace: text,
    ? artifact_namespace: text,
    trusted_cache_writes: bool
}
ListExecutionProfilesRequest = { organization: text }
ListExecutionProfilesResponse = { profiles: [* ExecutionProfileSummary] }
PutExecutionProfileRequest = { organization: text, profile: ExecutionProfileSummary }
PutExecutionProfileResponse = { profile: ExecutionProfileSummary }
DeleteExecutionProfileRequest = { organization: text, name: text }
DeleteExecutionProfileResponse = { deleted: bool }

WorkerClassSummary = { name: text, protected: bool, pool_ids: [* text] }
ListWorkerClassesRequest = { organization: text }
ListWorkerClassesResponse = { worker_classes: [* WorkerClassSummary] }
PutWorkerClassRequest = { organization: text, worker_class: WorkerClassSummary }
PutWorkerClassResponse = { worker_class: WorkerClassSummary }
DeleteWorkerClassRequest = { organization: text, name: text }
DeleteWorkerClassResponse = { deleted: bool }
SetWorkerClassPoolRequest = { organization: text, worker_class: text, pool_id: text, granted: bool }
SetWorkerClassPoolResponse = { ok: bool }

CreateCiApprovalRequest = {
    organization: text,
    project: text,
    pr_number: int,
    head_repository: text,
    head_sha: text,
    base_sha: text,
    policy_revision: text,
    workflow_scope: text,
    execution_profile: text,
    approver_subject: text,
    ? expires_at: text
}
CreateCiApprovalResponse = { approval_id: text }

ProjectSummary = {
    project_id: text,
    org_id: text,
    name: text,
    description: text,
    repo_url: text,
    is_private: bool,
    enabled: bool,
    created_at: text,
    updated_at: text
}
ListProjectsRequest = {
    ? org_id: text
}
ListProjectsResponse = {
    projects: [* ProjectSummary]
}

ProjectDetail = {
    project_id: text,
    org_id: text,
    name: text,
    description: text,
    repo_url: text,
    is_private: bool,
    enabled: bool,
    target_branches: [* text],
    allowed_event_types: [* text],
    default_ci_source_type: text,
    default_ci_source_url: text,
    default_ci_source_ref: text,
    default_runner_image: text,
    default_job_command: text,
    default_timeout_seconds: int,
    default_queue_name: text,
    checkout_mode: text,
    created_at: text,
    updated_at: text
}
GetProjectRequest = {
    project_id: text
}
GetProjectResponse = {
    project: ProjectDetail
}

CreateProjectRequest = {
    org_id: text,
    name: text,
    ? description: text,
    repo_url: text,
    ? is_private: bool,
    ? target_branches: [* text],
    ? allowed_event_types: [* text],
    ? checkout_mode: text
}
CreateProjectResponse = {
    project: ProjectDetail
}

UpdateProjectRequest = {
    project_id: text,
    ? name: text,
    ? description: text,
    ? is_private: bool,
    ? enabled: bool,
    ? target_branches: [* text],
    ? allowed_event_types: [* text],
    ? default_runner_image: text,
    ? default_job_command: text,
    ? default_timeout_seconds: int,
    ? default_queue_name: text,
    ? checkout_mode: text
}
UpdateProjectResponse = {
    project: ProjectDetail
}

DeleteProjectRequest = {
    project_id: text
}
DeleteProjectResponse = {
    deleted: bool
}

;;; The CI policy document, as a type rather than an opaque blob. Mirrors
;;; internal/cipolicy.Policy exactly. Storage has always been JSONB and
;;; put-ci-policy has always canonicalized on save, so nothing about the
;;; stored form changes here -- only that the wire carries the structure
;;; instead of a JSON string a client would have to parse and validate itself.
CiPolicySubjectMatch = {
    any: [* text]
}

;;; Grants selected workflow nodes trusted base-CI authority inside a head-CI
;;; workflow. Only coordinator policy can carry this grant.
CiPolicyNodeAuthority = {
    nodes: [* text],
    ? ci_source: text,
    ? profile: text,
    ? workers: text
}

CiPolicyUse = {
    ? ci_source: text,
    ? profile: text,
    ? workers: text,
    ? base_nodes: [* CiPolicyNodeAuthority]
}

CiPolicyDefaults = {
    ? ci_source: text,
    ? profile: text
}

CiPolicyRule = {
    id: text,
    ? actors: CiPolicySubjectMatch,
    ? workflows: [* text],
    ? paths: [* text],
    ? events: [* text],
    ? base_branches: [* text],
    ? head_repository: text,
    ? approval: CiPolicySubjectMatch,
    use: CiPolicyUse
}

CiPolicyDocument = {
    version: int,
    ? defaults: CiPolicyDefaults,
    head_ci: [* CiPolicyRule]
}

CiPolicyDetail = {
    policy_id: text,
    project_id: text,
    revision: text,
    document: CiPolicyDocument,
    created_at: text,
    updated_at: text,
    ? updated_by: text
}
GetCiPolicyRequest = {
    project_id: text
}
GetCiPolicyResponse = {
    policy: CiPolicyDetail
}
PutCiPolicyRequest = {
    project_id: text,
    document: CiPolicyDocument,
    ? expected_revision: text
}
PutCiPolicyResponse = {
    policy: CiPolicyDetail
}
DeleteCiPolicyRequest = {
    project_id: text,
    ? expected_revision: text
}
DeleteCiPolicyResponse = {
    deleted: bool
}

GroupSummary = {
    group_id: text,
    org_id: text,
    name: text,
    ? description: text,
    created_at: text,
    updated_at: text
}
ListGroupsRequest = {
    org_id: text
}
ListGroupsResponse = {
    groups: [* GroupSummary]
}

CreateGroupRequest = {
    org_id: text,
    name: text,
    ? description: text
}
CreateGroupResponse = {
    group: GroupSummary
}

UpdateGroupRequest = {
    group_id: text,
    ? name: text,
    ? description: text
}
UpdateGroupResponse = {
    group: GroupSummary
}

DeleteGroupRequest = {
    group_id: text
}
DeleteGroupResponse = {
    deleted: bool
}

AddGroupMemberRequest = {
    group_id: text,
    user_id: text
}
AddGroupMemberResponse = {
    added: bool
}

RemoveGroupMemberRequest = {
    group_id: text,
    user_id: text
}
RemoveGroupMemberResponse = {
    removed: bool
}

;;; A single group member, with just enough user info to render a member
;;; list (see internal/store/models.User's fields exposed via GetUserByID).
GroupMemberEntry = {
    user_id: text,
    username: text
}
ListGroupMembersRequest = {
    group_id: text
}
ListGroupMembersResponse = {
    members: [* GroupMemberEntry]
}

RoleAssignment = {
    assignment_id: text,
    principal_type: text, ;; user | group
    principal_id: text,
    scope_type: text, ;; global | org | project
    ? scope_id: text,
    role: text, ;; admin | owner | member
    created_at: text,
    ? created_by: text
}
ListRoleAssignmentsRequest = {
    ? scope_type: text,
    ? scope_id: text,
    ? principal_id: text
}
ListRoleAssignmentsResponse = {
    assignments: [* RoleAssignment]
}

AssignRoleRequest = {
    principal_type: text,
    principal_id: text,
    scope_type: text,
    ? scope_id: text,
    role: text
}
AssignRoleResponse = {
    assignment: RoleAssignment
}

RevokeRoleRequest = {
    assignment_id: text
}
RevokeRoleResponse = {
    revoked: bool
}

;;; Webhook secret metadata only. The secret value is write-only: it is
;;; accepted on add-webhook-secret and never returned by any op.
WebhookSecretSummary = {
    id: text,
    project_id: text,
    provider: text,
    name: text,
    is_active: bool,
    ? last_used_at: text,
    created_at: text,
    ? deactivated_at: text
}
ListWebhookSecretsRequest = {
    project_id: text
}
ListWebhookSecretsResponse = {
    secrets: [* WebhookSecretSummary]
}

AddWebhookSecretRequest = {
    project_id: text,
    provider: text,
    name: text,
    value: text
}
AddWebhookSecretResponse = {
    secret: WebhookSecretSummary
}

DeactivateWebhookSecretRequest = {
    id: text
}
DeactivateWebhookSecretResponse = {
    secret: WebhookSecretSummary
}

DeleteWebhookSecretRequest = {
    id: text
}
DeleteWebhookSecretResponse = {
    deleted: bool
}

;;; VCS credential metadata only; same rotation shape as webhook secrets.
VcsCredentialSummary = {
    id: text,
    project_id: text,
    provider: text,
    name: text,
    is_active: bool,
    ? last_used_at: text,
    created_at: text,
    ? deactivated_at: text
}
ListVcsCredentialsRequest = {
    project_id: text
}
ListVcsCredentialsResponse = {
    credentials: [* VcsCredentialSummary]
}

AddVcsCredentialRequest = {
    project_id: text,
    provider: text,
    name: text,
    value: text
}
AddVcsCredentialResponse = {
    credential: VcsCredentialSummary
}

DeactivateVcsCredentialRequest = {
    id: text
}
DeactivateVcsCredentialResponse = {
    credential: VcsCredentialSummary
}

DeleteVcsCredentialRequest = {
    id: text
}
DeleteVcsCredentialResponse = {
    deleted: bool
}

;;; Secrets are write-only through the UI: set/delete/list-paths only. No op
;;; ever returns a secret value.
SetSecretRequest = {
    org_id: text,
    path: text,
    key: text,
    value: text
}
SetSecretResponse = {
    ok: bool
}

DeleteSecretRequest = {
    org_id: text,
    path: text,
    key: text
}
DeleteSecretResponse = {
    deleted: bool
}

SecretPathEntry = {
    path: text,
    keys: [* text]
}
ListSecretPathsRequest = {
    org_id: text,
    ? path_prefix: text
}
ListSecretPathsResponse = {
    paths: [* SecretPathEntry]
}

;;; Secret grants authorize a job to resolve secrets under a path pattern;
;;; field names mirror internal/store/models.SecretGrant.
SecretGrant = {
    grant_id: text,
    org_id: text,
    ? project_id: text,
    name: text,
    secret_path_match: text, ;; any | exact | prefix | glob | regex
    secret_path_pattern: text,
    job_name_match: text, ;; any | exact | prefix | glob | regex
    ? job_name_pattern: text,
    ? description: text,
    created_at: text,
    updated_at: text
}
ListSecretGrantsRequest = {
    org_id: text
}
ListSecretGrantsResponse = {
    grants: [* SecretGrant]
}

CreateSecretGrantRequest = {
    org_id: text,
    ? project_id: text,
    name: text,
    secret_path_match: text,
    secret_path_pattern: text,
    ? job_name_match: text,
    ? job_name_pattern: text,
    ? description: text
}
CreateSecretGrantResponse = {
    grant: SecretGrant
}

UpdateSecretGrantRequest = {
    grant_id: text,
    ? name: text,
    ? secret_path_match: text,
    ? secret_path_pattern: text,
    ? job_name_match: text,
    ? job_name_pattern: text,
    ? description: text
}
UpdateSecretGrantResponse = {
    grant: SecretGrant
}

DeleteSecretGrantRequest = {
    grant_id: text
}
DeleteSecretGrantResponse = {
    deleted: bool
}

;;; Cancel is graceful (SIGTERM + CLEANUP phase); kill is immediate/forced.
CancelJobRequest = {
    job_id: text
}
CancelJobResponse = {
    job_id: text,
    status: text
}

KillJobRequest = {
    job_id: text
}
KillJobResponse = {
    job_id: text,
    status: text
}

CancelWorkflowRequest = {
    workflow_instance_id: text
}
CancelWorkflowResponse = {
    workflow_instance_id: text,
    status: text
}

;;; Retry re-submits a failed/cancelled job or workflow. RetryJob clones a
;;; single job in place (same workflow node, if any) into a brand-new job
;;; row; RetryWorkflow starts a fresh workflow instance from a failed/
;;; cancelled one (old instance untouched); RetryUnsuccessfulJobs bulk-
;;; applies RetryJob to every failed/cancelled member job of a workflow, in
;;; place. See internal/jobcontrol/retry.go.
RetryJobRequest = {
    job_id: text
}
RetryJobResponse = {
    job_id: text,
    status: text
}

RetryWorkflowRequest = {
    workflow_instance_id: text
}
RetryWorkflowResponse = {
    workflow_instance_id: text,
    status: text
}

RetryUnsuccessfulJobsRequest = {
    workflow_instance_id: text
}
RetryUnsuccessfulJobsResponse = {
    job_ids: [* text],
    retried_count: int,
    skipped_count: int
}

;;; Global settings are a k/v store; value is opaque CBOR/JSON-ish data.
GlobalSettingEntry = {
    key: text,
    value: any,
    updated_at: text
}
GetGlobalSettingsRequest = {}
GetGlobalSettingsResponse = {
    new_projects_private: bool,
    settings: [* GlobalSettingEntry]
}

UpdateGlobalSettingsRequest = {
    ? new_projects_private: bool,
    ? settings: [* GlobalSettingEntry]
}
UpdateGlobalSettingsResponse = {
    new_projects_private: bool,
    settings: [* GlobalSettingEntry]
}

;;; Trusted identity admission list: exact `[handle@]domain` selectors.
TrustedIdentity = {
    domain: text,
    handle: text,
    source: text, ;; config | admin
    created_at: text
}
ListTrustedIdentitiesRequest = {}
ListTrustedIdentitiesResponse = {
    identities: [* TrustedIdentity]
}

AddTrustedIdentityRequest = {
    domain: text,
    ? handle: text
}
AddTrustedIdentityResponse = {
    identity: TrustedIdentity
}

RemoveTrustedIdentityRequest = {
    domain: text,
    ? handle: text
}
RemoveTrustedIdentityResponse = {
    removed: bool
}

;;; Trusted domain admission patterns: RE2 regexes over the login domain.
TrustedDomainPattern = {
    pattern_id: text,
    pattern: text,
    ? description: text,
    ? created_by: text,
    created_at: text
}
ListTrustedDomainPatternsRequest = {}
ListTrustedDomainPatternsResponse = {
    patterns: [* TrustedDomainPattern]
}

AddTrustedDomainPatternRequest = {
    pattern: text,
    ? description: text
}
AddTrustedDomainPatternResponse = {
    pattern: TrustedDomainPattern
}

RemoveTrustedDomainPatternRequest = {
    pattern_id: text
}
RemoveTrustedDomainPatternResponse = {
    removed: bool
}

;; ---------------------------------------------------------------------------
;; Worker, queue, and pool administration. These operations are gated by
;; authz.Caps.ManageWorkers.
;; (org-admin/global-admin tier) -- see get-capabilities' manage_workers
;; field above. Queues have no creation path that sets an owning org today,
;; so queue ops require global admin; pools/workers/enrollment tokens may be
;; org-scoped (an org admin of that pool's org may manage it) or global
;; (global admin only, when the pool has no org).
;; ---------------------------------------------------------------------------

;;; Scalar-only characteristic value -- used for queues (job/queue
;;; characteristics are always scalar, never lists, per
;;; "Characteristics & matching").
CharacteristicScalar = text / int / bool

CharacteristicEntry = {
    key: text,
    value: CharacteristicScalar
}

;;; Worker characteristic values may additionally be a homogeneous list
;;; (worker-only) -- structurally identical to reactorcide-worker.csil's
;;; CharacteristicValue, independently defined here (this file's own
;;; generated package) rather than shared across an `include`, same
;;; rationale as this file's own ServiceError mirror.
WorkerCharacteristicValue = text / int / bool / [* text] / [* int] / [* bool]

WorkerCharacteristicEntry = {
    key: text,
    value: WorkerCharacteristicValue
}

QueueSummary = {
    queue_id: text,
    queue_uuid: text,
    characteristics: [* CharacteristicEntry],
    display_name: text,
    is_default: bool,
    backlog_count: int
}

ListQueuesRequest = {}
ListQueuesResponse = {
    queues: [* QueueSummary]
}

;;; CreateQueue lets an operator pre-create a queue (define characteristics +
;;; display name up front). Characteristics are immutable once created --
;;; there is no update-characteristics op, only rename-queue for the display
;;; name.
CreateQueueRequest = {
    characteristics: [* CharacteristicEntry],
    ? display_name: text
}
CreateQueueResponse = {
    queue: QueueSummary
}

RenameQueueRequest = {
    queue_id: text,
    display_name: text
}
RenameQueueResponse = {
    queue: QueueSummary
}

;;; DeleteQueue cancels every non-terminal job routed to the queue (via the
;;; existing cancel path) before removing the row. The seeded default queue
;;; (is_default) may never be deleted -- rejected with invalid_argument.
DeleteQueueRequest = {
    queue_id: text
}
DeleteQueueResponse = {
    deleted: bool,
    cancelled_job_ids: [* text]
}

WorkerSummary = {
    worker_id: text,
    pool_id: text,
    worker_key: text,
    ? hostname: text,
    os: text,
    arch: text,
    characteristics: [* WorkerCharacteristicEntry],
    ? worker_version: text,
    status: text, ;; active | quarantined | disabled
    ? last_seen_at: text,
    active_lease_count: int
}

ListWorkersRequest = {
    ? pool_id: text
}
ListWorkersResponse = {
    workers: [* WorkerSummary]
}

;;; SetWorkerStatus is the quarantine/disable/re-activate admin control:
;;; status must be one of active/quarantined/disabled. A non-active worker's
;;; RequestJob calls are refused no future job offers (internal/workerapi's
;;; RequestJob checks worker status before matching).
SetWorkerStatusRequest = {
    worker_id: text,
    status: text
}
SetWorkerStatusResponse = {
    worker: WorkerSummary
}

;;; DrainWorker asks a worker to stop accepting new work without disabling it
;;; outright: modeled as the "quarantined" status (RequestJob already offers
;;; no further jobs to a non-active worker) plus a heartbeat drain directive
;;; so a worker still finishing existing leases learns to shut down once they
;;; complete -- see internal/workerapi/service.go's Heartbeat.
DrainWorkerRequest = {
    worker_id: text
}
DrainWorkerResponse = {
    worker: WorkerSummary
}

WorkerPoolSummary = {
    pool_id: text,
    ? org_id: text,
    name: text,
    ? description: text,
    created_at: text,
    updated_at: text
}

ListPoolsRequest = {
    ? org_id: text
}
ListPoolsResponse = {
    pools: [* WorkerPoolSummary]
}

CreatePoolRequest = {
    ? org_id: text,
    name: text,
    ? description: text
}
CreatePoolResponse = {
    pool: WorkerPoolSummary
}

UpdatePoolRequest = {
    pool_id: text,
    ? name: text,
    ? description: text
}
UpdatePoolResponse = {
    pool: WorkerPoolSummary
}

DeletePoolRequest = {
    pool_id: text
}
DeletePoolResponse = {
    deleted: bool
}

;;; Enrollment token metadata only -- list/deactivate never return the raw
;;; token or its hash. SECURITY: create-enrollment-token is the only op that
;;; ever returns the raw value, exactly once at creation; it is stored
;;; hash-only and no op (including list-enrollment-tokens) ever returns it
;;; again.
EnrollmentTokenSummary = {
    token_id: text,
    pool_id: text,
    ? name: text,
    is_active: bool,
    ? last_used_at: text,
    created_at: text,
    ? deactivated_at: text
}

CreateEnrollmentTokenRequest = {
    pool_id: text,
    ? name: text
}
;;; SECURITY: token is the raw enrollment token, returned exactly once here.
;;; Only its SHA-256 hash is ever persisted (internal/workerauth); no other
;;; op returns it again, and it must never be logged.
CreateEnrollmentTokenResponse = {
    token: text,
    summary: EnrollmentTokenSummary
}

ListEnrollmentTokensRequest = {
    pool_id: text
}
ListEnrollmentTokensResponse = {
    tokens: [* EnrollmentTokenSummary]
}

DeactivateEnrollmentTokenRequest = {
    token_id: text
}
DeactivateEnrollmentTokenResponse = {
    summary: EnrollmentTokenSummary
}

;;; Graph-ready job resource metrics. All values are integer-scaled by unit.
;;; Timestamps are RFC3339 UTC text, matching other UI service timestamps.
GetJobMetricsRequest = {
    job_id: text,
    ? from_time: text,
    ? to_time: text,
    ? cursor: text,
    metrics: [* text],
    max_points: int,
    ;; "summary" (default) returns the job roll-up only, restricted to the
    ;; metrics a chart actually reads. "raw" returns every series, per
    ;; component. An unknown value falls back to "summary" rather than failing.
    ? view: text,
    ;; Narrows to one container's series (e.g. "main", "builder", "docker").
    ;; Empty means no narrowing.
    ? component: text
}

JobMetricLabel = {
    key: text,
    value: text
}

JobMetricUnavailable = {
    metric_prefix: text,
    reason: text
}

JobMetricPoint = {
    observed_at: text,
    value: int,
    ? min: int,
    ? max: int
}

JobMetricSeries = {
    name: text,
    unit: text,
    labels: [* JobMetricLabel],
    points: [* JobMetricPoint]
}

GetJobMetricsResponse = {
    series: [* JobMetricSeries],
    unavailable: [* JobMetricUnavailable],
    complete: bool,
    ? next_cursor: text,
    ;; Every component present in this job's telemetry, computed BEFORE the
    ;; view filtered anything out. The UI shows a component picker only when
    ;; this has entries, so a single-container job grows no pointless control
    ;; and a job whose sidecar starts late grows one at that moment.
    components: [* text]
}

GetJobLogsRequest = {
    job_id: text,
    stream: text,
    ? cursor: text,
    ? max_entries: int
}
JobLogEntry = {
    timestamp: text,
    stream: text,
    level: text,
    message: text
}
GetJobLogsResponse = {
    entries: [* JobLogEntry],
    ? next_cursor: text,
    ? has_more: bool,
    ? complete: bool
}

;; ---------------------------------------------------------------------------
;; Job and workflow reads.
;;
;; These exist so the browser never needs the coordinator REST API. The webapp
;; used to serve the job list, job detail, workflow list and workflow detail
;; by calling /api/v1/* with its own SERVICE token; the coordinator's
;; visibility filter then ran against that service identity and passed every
;; row, and the webapp did not filter again. Every op below instead resolves
;; the caller's own session and pushes the visibility predicate into SQL
;; (postgres_store/visibility_operations.go), so LIMIT/OFFSET and the total
;; count both operate on the already-filtered set.
;; ---------------------------------------------------------------------------

;;; One job as the UI lists and renders it. Field names match models.Job's
;;; JSON so the existing REST consumers read the same shape.
JobSummary = {
    job_id: text,
    name: text,
    description: text,
    status: text,
    last_error: text,
    created_at: text,
    updated_at: text,
    ? started_at: text,
    ? completed_at: text,
    ? exit_code: int,
    source_url: text,
    source_ref: text,
    source_type: text,
    source_path: text,
    runner_image: text,
    queue_name: text,
    priority: int,
    ? parent_job_id: text,
    ? project_id: text,
    ? workflow_id: text,
    workflow_node_name: text,
    ci_origin: text,
    execution_profile: text,
    worker_class: text
}

ListJobsRequest = {
    ? status: text,
    ? project_id: text,
    ? workflow_id: text,
    ? queue_name: text,
    ? limit: int,
    ? offset: int
}
ListJobsResponse = {
    jobs: [* JobSummary],
    total: int,
    limit: int,
    offset: int
}

GetJobRequest = {
    job_id: text
}
GetJobResponse = {
    job: JobSummary
}

;;; One node of a workflow's DAG. depends_on is what a graph view needs; it
;;; has always existed on the row and was never exposed by any API.
WorkflowNodeSummary = {
    node_id: text,
    name: text,
    display_name: text,
    status: text,
    depends_on: [* text],
    condition: text,
    ? job_id: text,
    decision_reason: text,
    ? item_index: int,
    ? completed_at: text,
    ci_origin: text,
    execution_profile: text,
    worker_class: text
}

WorkflowSummaryDetail = {
    workflow_id: text,
    kind: text,
    name: text,
    status: text,
    ? project_id: text,
    created_at: text,
    updated_at: text,
    ? completed_at: text,
    queue_name: text,
    vcs_repo: text,
    ? pr_number: int,
    commit_sha: text,
    job_count: int,
    running_count: int,
    completed_count: int,
    failed_count: int,
    skipped_count: int,
    ? loose_job_id: text,
    ? loose_job_exit: int,
    decision_summary: text,
    ? parent_job_id: text,
    ? root_workflow_id: text,
    ? parent_workflow_id: text,
    ? origin_job_id: text,
    origin_type: text,
    trigger_type: text,
    ci_origin: text,
    execution_profile: text,
    worker_class: text
}

ListWorkflowsRequest = {
    ? status: text,
    ? project_id: text,
    ? limit: int,
    ? offset: int
}
ListWorkflowsResponse = {
    workflows: [* WorkflowSummaryDetail],
    total: int,
    limit: int,
    offset: int
}

;;; get-workflow returns the nodes inline. A workflow, even a large one, is
;;; small next to everything else the UI already transfers, so a second round
;;; trip to fetch its DAG buys nothing.
GetWorkflowRequest = {
    workflow_id: text
}
GetWorkflowResponse = {
    workflow: WorkflowSummaryDetail,
    nodes: [* WorkflowNodeSummary],
    jobs: [* JobSummary]
}

;; ---------------------------------------------------------------------------
;; Form metadata.
;;
;; The enumerated values a form needs (event types, checkout modes, node
;; conditions) live only in Go today -- internal/vcs/event_types.go and
;; friends. A client that wants to offer them in a combobox has to copy the
;; list, and a copied list drifts. Serve them instead.
;; ---------------------------------------------------------------------------

EnumChoice = {
    value: text,
    label: text,
    description: text
}

;;; Each field is one enumerated set a form control can bind to directly.
;;;
;;; Every value here is a static vocabulary of the software itself, so this op
;;; is open to anonymous callers. Deployment data -- worker classes, execution
;;; profiles, queue names -- is deliberately NOT served here: those are
;;; org-scoped and privileged, and list-worker-classes /
;;; list-execution-profiles / list-queues already authorize them correctly. A
;;; form that needs one of those calls the op that guards it.
DescribeFormMetadataRequest = {}
DescribeFormMetadataResponse = {
    event_types: [* EnumChoice],
    checkout_modes: [* EnumChoice],
    node_conditions: [* EnumChoice],
    job_statuses: [* EnumChoice],
    workflow_statuses: [* EnumChoice],
    ci_source_types: [* EnumChoice]
}

service ReactorcideUi {
    get-capabilities: GetCapabilitiesRequest -> GetCapabilitiesResponse / ServiceError,
    list-orgs: ListOrgsRequest -> ListOrgsResponse / ServiceError,
    create-org: CreateOrgRequest -> CreateOrgResponse / ServiceError,
    update-org: UpdateOrgRequest -> UpdateOrgResponse / ServiceError,
    set-default-org: SetDefaultOrgRequest -> SetDefaultOrgResponse / ServiceError,
    delete-org: DeleteOrgRequest -> DeleteOrgResponse / ServiceError,
    list-execution-profiles: ListExecutionProfilesRequest -> ListExecutionProfilesResponse / ServiceError,
    put-execution-profile: PutExecutionProfileRequest -> PutExecutionProfileResponse / ServiceError,
    delete-execution-profile: DeleteExecutionProfileRequest -> DeleteExecutionProfileResponse / ServiceError,
    list-worker-classes: ListWorkerClassesRequest -> ListWorkerClassesResponse / ServiceError,
    put-worker-class: PutWorkerClassRequest -> PutWorkerClassResponse / ServiceError,
    delete-worker-class: DeleteWorkerClassRequest -> DeleteWorkerClassResponse / ServiceError,
    set-worker-class-pool: SetWorkerClassPoolRequest -> SetWorkerClassPoolResponse / ServiceError,
    create-ci-approval: CreateCiApprovalRequest -> CreateCiApprovalResponse / ServiceError,
    list-projects: ListProjectsRequest -> ListProjectsResponse / ServiceError,
    get-project: GetProjectRequest -> GetProjectResponse / ServiceError,
    create-project: CreateProjectRequest -> CreateProjectResponse / ServiceError,
    update-project: UpdateProjectRequest -> UpdateProjectResponse / ServiceError,
    delete-project: DeleteProjectRequest -> DeleteProjectResponse / ServiceError,
    get-ci-policy: GetCiPolicyRequest -> GetCiPolicyResponse / ServiceError,
    put-ci-policy: PutCiPolicyRequest -> PutCiPolicyResponse / ServiceError,
    delete-ci-policy: DeleteCiPolicyRequest -> DeleteCiPolicyResponse / ServiceError,
    list-groups: ListGroupsRequest -> ListGroupsResponse / ServiceError,
    create-group: CreateGroupRequest -> CreateGroupResponse / ServiceError,
    update-group: UpdateGroupRequest -> UpdateGroupResponse / ServiceError,
    delete-group: DeleteGroupRequest -> DeleteGroupResponse / ServiceError,
    add-group-member: AddGroupMemberRequest -> AddGroupMemberResponse / ServiceError,
    remove-group-member: RemoveGroupMemberRequest -> RemoveGroupMemberResponse / ServiceError,
    list-group-members: ListGroupMembersRequest -> ListGroupMembersResponse / ServiceError,
    list-role-assignments: ListRoleAssignmentsRequest -> ListRoleAssignmentsResponse / ServiceError,
    assign-role: AssignRoleRequest -> AssignRoleResponse / ServiceError,
    revoke-role: RevokeRoleRequest -> RevokeRoleResponse / ServiceError,
    list-webhook-secrets: ListWebhookSecretsRequest -> ListWebhookSecretsResponse / ServiceError,
    add-webhook-secret: AddWebhookSecretRequest -> AddWebhookSecretResponse / ServiceError,
    deactivate-webhook-secret: DeactivateWebhookSecretRequest -> DeactivateWebhookSecretResponse / ServiceError,
    delete-webhook-secret: DeleteWebhookSecretRequest -> DeleteWebhookSecretResponse / ServiceError,
    list-vcs-credentials: ListVcsCredentialsRequest -> ListVcsCredentialsResponse / ServiceError,
    add-vcs-credential: AddVcsCredentialRequest -> AddVcsCredentialResponse / ServiceError,
    deactivate-vcs-credential: DeactivateVcsCredentialRequest -> DeactivateVcsCredentialResponse / ServiceError,
    delete-vcs-credential: DeleteVcsCredentialRequest -> DeleteVcsCredentialResponse / ServiceError,
    set-secret: SetSecretRequest -> SetSecretResponse / ServiceError,
    delete-secret: DeleteSecretRequest -> DeleteSecretResponse / ServiceError,
    list-secret-paths: ListSecretPathsRequest -> ListSecretPathsResponse / ServiceError,
    list-secret-grants: ListSecretGrantsRequest -> ListSecretGrantsResponse / ServiceError,
    create-secret-grant: CreateSecretGrantRequest -> CreateSecretGrantResponse / ServiceError,
    update-secret-grant: UpdateSecretGrantRequest -> UpdateSecretGrantResponse / ServiceError,
    delete-secret-grant: DeleteSecretGrantRequest -> DeleteSecretGrantResponse / ServiceError,
    cancel-job: CancelJobRequest -> CancelJobResponse / ServiceError,
    kill-job: KillJobRequest -> KillJobResponse / ServiceError,
    cancel-workflow: CancelWorkflowRequest -> CancelWorkflowResponse / ServiceError,
    retry-job: RetryJobRequest -> RetryJobResponse / ServiceError,
    retry-workflow: RetryWorkflowRequest -> RetryWorkflowResponse / ServiceError,
    retry-unsuccessful-jobs: RetryUnsuccessfulJobsRequest -> RetryUnsuccessfulJobsResponse / ServiceError,
    get-global-settings: GetGlobalSettingsRequest -> GetGlobalSettingsResponse / ServiceError,
    update-global-settings: UpdateGlobalSettingsRequest -> UpdateGlobalSettingsResponse / ServiceError,
    list-trusted-identities: ListTrustedIdentitiesRequest -> ListTrustedIdentitiesResponse / ServiceError,
    add-trusted-identity: AddTrustedIdentityRequest -> AddTrustedIdentityResponse / ServiceError,
    remove-trusted-identity: RemoveTrustedIdentityRequest -> RemoveTrustedIdentityResponse / ServiceError,
    list-trusted-domain-patterns: ListTrustedDomainPatternsRequest -> ListTrustedDomainPatternsResponse / ServiceError,
    add-trusted-domain-pattern: AddTrustedDomainPatternRequest -> AddTrustedDomainPatternResponse / ServiceError,
    remove-trusted-domain-pattern: RemoveTrustedDomainPatternRequest -> RemoveTrustedDomainPatternResponse / ServiceError,
    list-queues: ListQueuesRequest -> ListQueuesResponse / ServiceError,
    create-queue: CreateQueueRequest -> CreateQueueResponse / ServiceError,
    rename-queue: RenameQueueRequest -> RenameQueueResponse / ServiceError,
    delete-queue: DeleteQueueRequest -> DeleteQueueResponse / ServiceError,
    list-workers: ListWorkersRequest -> ListWorkersResponse / ServiceError,
    set-worker-status: SetWorkerStatusRequest -> SetWorkerStatusResponse / ServiceError,
    drain-worker: DrainWorkerRequest -> DrainWorkerResponse / ServiceError,
    list-pools: ListPoolsRequest -> ListPoolsResponse / ServiceError,
    create-pool: CreatePoolRequest -> CreatePoolResponse / ServiceError,
    update-pool: UpdatePoolRequest -> UpdatePoolResponse / ServiceError,
    delete-pool: DeletePoolRequest -> DeletePoolResponse / ServiceError,
    create-enrollment-token: CreateEnrollmentTokenRequest -> CreateEnrollmentTokenResponse / ServiceError,
    list-enrollment-tokens: ListEnrollmentTokensRequest -> ListEnrollmentTokensResponse / ServiceError,
    deactivate-enrollment-token: DeactivateEnrollmentTokenRequest -> DeactivateEnrollmentTokenResponse / ServiceError,
    get-job-metrics: GetJobMetricsRequest -> GetJobMetricsResponse / ServiceError,
    get-job-logs: GetJobLogsRequest -> GetJobLogsResponse / ServiceError,
    list-jobs: ListJobsRequest -> ListJobsResponse / ServiceError,
    get-job: GetJobRequest -> GetJobResponse / ServiceError,
    list-workflows: ListWorkflowsRequest -> ListWorkflowsResponse / ServiceError,
    get-workflow: GetWorkflowRequest -> GetWorkflowResponse / ServiceError,
    describe-form-metadata: DescribeFormMetadataRequest -> DescribeFormMetadataResponse / ServiceError
}
